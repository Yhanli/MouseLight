root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
# Matches the existing code: braces on new lines, m_ prefix for private fields, s_ for static ones.
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true

[*.{xml,csproj,pubxml,props,targets}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
